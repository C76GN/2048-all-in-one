  "runtime_literal_rules": [
    {
      "script_path": "res://addons/gf/kernel/core/gf.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "GF validates configured installer paths; this literal is a scheme token, not a load target."
    },
    {
      "script_path": "res://addons/gf/kernel/core/gf_report_value_codec.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "Report encoding classifies values that look like resource paths."
    },
    {
      "script_path": "res://addons/gf/extensions/content_package/runtime/gf_content_package_utility.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "Content package source-root validation compares the resource scheme."
    },
    {
      "script_path": "res://addons/gf/kernel/extension/gf_extension_settings.gd",
      "literal": "res://",
      "expected_count": 4,
      "kind": "path_scheme_sentinel",
      "reason": "Extension path and preset validators compare exact resource-scheme tokens."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/scene/gf_scene_utility.gd",
      "literal": "res://",
      "expected_count": 2,
      "kind": "path_scheme_sentinel",
      "reason": "Scene path normalization strips and restores the resource scheme."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/scene/gf_scene_utility.gd",
      "literal": "res://%s",
      "expected_count": 1,
      "kind": "path_normalization_template",
      "reason": "Scene normalization reattaches the scheme to its already validated input; route targets are rooted by the preload map."
    },
    {
      "script_path": "res://features/navigation/scripts/systems/scene_router_system.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "The project scene router validates route paths against the resource scheme."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/logging/gf_log_utility.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "Log sanitization recognizes resource paths before removing path details."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/assets/gf_resource_resolver_utility.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "The resolver classifies an already resolved string as a resource path."
    },
    {
      "script_path": "res://addons/gf/extensions/content_package/resources/gf_content_package_manifest.gd",
      "literal": "res://, user:// or package-relative path",
      "expected_count": 2,
      "kind": "validation_message",
      "reason": "This is validation prose embedded in two schema error messages, not a path."
    },
    {
      "script_path": "res://addons/gf/extensions/content_package/resources/gf_content_package_manifest.gd",
      "literal": "res://",
      "expected_count": 2,
      "kind": "path_scheme_sentinel",
      "reason": "Manifest path validators compare supported resource schemes."
    },
    {
      "script_path": "res://addons/gf/kernel/extension/gf_extension_manifest.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "Extension manifest validation requires installer contributions to be resource paths."
    },
    {
      "script_path": "res://addons/gf/kernel/extension/gf_extension_preset_discovery.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "Preset discovery validates configured preset paths against the resource scheme."
    },
    {
      "script_path": "res://addons/gf/kernel/extension/gf_extension_selection_discovery.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "Selection discovery validates manifest contribution paths."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/assets/gf_resource_registry_tools.gd",
      "literal": "res://addons",
      "expected_count": 1,
      "kind": "scanner_default_exclusion",
      "reason": "The generic registry builder excludes addons by default; it does not load this directory."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/assets/gf_resource_registry_tools.gd",
      "literal": "res://",
      "expected_count": 6,
      "kind": "tool_api_path_default",
      "reason": "Generic registry-tool defaults and dependency token parsing; release runtime only calls dependency collection with concrete rooted resources."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/debug/gf_build_info.gd",
      "literal": "res://addons/gf/plugin.cfg",
      "expected_count": 1,
      "kind": "optional_diagnostic_metadata",
      "reason": "Framework-version diagnostics tolerate this editor plugin metadata being absent from release exports."
    },
    {
      "script_path": "res://addons/gf/extensions/content_package/runtime/gf_content_package_asset_catalog_provider.gd",
      "literal": "res://",
      "expected_count": 1,
      "kind": "path_scheme_sentinel",
      "reason": "Catalog entry normalization checks whether an already declared path is project-relative."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/io/gf_path_enumeration_tools.gd",
      "literal": "res://",
      "expected_count": 2,
      "kind": "tool_api_path_default",
      "reason": "Generic enumeration API defaults; release content enumeration uses explicitly declared package roots."
    },
    {
      "script_path": "res://addons/gf/standard/utilities/config/validation/gf_config_resource_path_validation_rule.gd",
      "literal": "res://",
      "expected_count": 3,
      "kind": "path_scheme_sentinel",
      "reason": "Configuration validation checks and reports the resource-path scheme."
    }
